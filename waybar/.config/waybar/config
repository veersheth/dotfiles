      "custom/notification": {
          "tooltip": false,
          "format": "󰂚",  // always show the bell
          "return-type": "string",
          "exec-if": "which dunstctl",
          "exec": "if dunstctl is-paused | grep -q true; then echo 'paused'; else echo 'running'; fi",
          "on-click": "bash -c 'dunstctl history | zenity --list --title=\"Notifications\" --column=\"Message\"'",
          "on-click-right": "dunstctl set-paused toggle",  // toggle pause
          "interval": 2,
          "escape": true
      },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "󰾅",
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰾆"
        }
    }, 

    "custom/media": {
      "format": "{}",
      "exec": "/home/veer/scripts/get-media-info.sh",
      "interval": 2,
      "max-length": 58,
      "on-click": "playerctl play-pause",
      "on-scroll-up": "playerctl next",
      "on-scroll-down": "playerctl previous"
    },

    "custom/powermenu": {
      "format": "",
      "tooltip": false,
      "on-click": "~/scripts/rofi-powermenu"
    }, 

    "custom/hypridle": {
      "format": "{text}",
      "return-type": "json",
      "exec": "/home/veer/.config/waybar/scripts/hypridle-caffeine-waybar.sh",
      "on-click": "/home/veer/scripts/hypridle-caffeine-toggle.sh",
      "interval": 5,
  }
}
