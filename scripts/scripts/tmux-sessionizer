#!/usr/bin/env bash

set -euo pipefail

HOME_SESSION="HOME"
TEMP_SESSION="TEMP"
TEMP_DIR="/tmp/tmuxtmp"

SEARCH_DIRS=(
    "$HOME"
    "$HOME/syncthing"
    "$HOME/code"
)

create_session() {
    local session_name="$1"
    local session_dir="$2"

    if ! tmux has-session -t="$session_name" 2>/dev/null; then
        tmux new-session -ds "$session_name" -c "$session_dir"
    fi
}

switch_or_attach() {
    local session_name="$1"

    if [[ -n "${TMUX:-}" ]]; then
        tmux switch-client -t "$session_name"
    else
        exec tmux attach-session -t "$session_name"
    fi
}

make_session_name() {
    local dir="$1"

    dir="$(realpath "$dir")"

    # Strip HOME prefix for readability
    dir="${dir/#$HOME\//}"

    # tmux-safe session name
    printf '%s\n' "$dir" \
        | tr '/' '_' \
        | tr -cd '[:alnum:]_-'
}

# -----------------------------------------------------------------------------
# --init
# -----------------------------------------------------------------------------

if [[ "${1:-}" == "--init" ]]; then
    mkdir -p "$TEMP_DIR"

    tmux start-server

    create_session "$HOME_SESSION" "$HOME"
    create_session "$TEMP_SESSION" "$TEMP_DIR"

    switch_or_attach "$HOME_SESSION"
    exit 0
fi

# -----------------------------------------------------------------------------
# Session selection
# -----------------------------------------------------------------------------

if [[ $# -eq 1 ]]; then
    selected="$1"
else
  selected=$(
        {
            printf '%s\n' "$HOME_SESSION" "$TEMP_SESSION"

            # 1. find -L follows symlinks
            find -L "${SEARCH_DIRS[@]}" \
                -mindepth 1 \
                -maxdepth 1 \
                -type d \
                2>/dev/null \
                | sed "s|^$HOME/||" # 2. Strip HOME directly from the find output
        } \
        | awk '!seen[$0]++' \
        | sort \
        | fzf --layout=reverse 
    ) || exit 0
fi

[[ -z "${selected:-}" ]] && exit 0

# -----------------------------------------------------------------------------
# Resolve session
# -----------------------------------------------------------------------------

case "$selected" in
    "$HOME_SESSION")
        session_name="$HOME_SESSION"
        session_dir="$HOME"
        ;;

    "$TEMP_SESSION")
        session_name="$TEMP_SESSION"
        session_dir="$TEMP_DIR"
        ;;

    *)
        if [[ "$selected" == /* ]]; then
            session_dir="$selected"
        else
            session_dir="$HOME/$selected"
        fi

        session_dir="$(realpath -m "$session_dir")"

        mkdir -p "$session_dir"

        session_name="$(make_session_name "$session_dir")"
        ;;
esac

# -----------------------------------------------------------------------------
# Create/switch
# -----------------------------------------------------------------------------

create_session "$session_name" "$session_dir"
switch_or_attach "$session_name"
