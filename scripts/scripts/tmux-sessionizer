#!/usr/bin/env bash
set -euo pipefail

HOME_SESSION="HOME"
TEMP_SESSION="TEMP"
TEMP_DIR="/tmp/tmuxtmp"

SEARCH_DIRS=(
    "$HOME"
    "$HOME/obsidian-vault-03"
    "$HOME/code"
    "$HOME/code/personal"
    "$HOME/code/unsw"
)

# --init
if [[ "${1:-}" == "--init" ]]; then
    mkdir -p "$TEMP_DIR"
    tmux start-server

    if ! tmux has-session -t "$HOME_SESSION" 2>/dev/null; then
        tmux new-session -d -s "$HOME_SESSION" -c "$HOME"
    fi
    if ! tmux has-session -t "$TEMP_SESSION" 2>/dev/null; then
        tmux new-session -d -s "$TEMP_SESSION" -c "$TEMP_DIR"
    fi

    if [[ -z "${TMUX:-}" ]]; then
        exec tmux attach-session -t "$HOME_SESSION"
    else
        tmux switch-client -t "$HOME_SESSION"
    fi
fi

# sessionizer
if [[ $# -eq 1 ]]; then
    selected="$1"
else
    selected=$(
        {
            printf '%s\n' "HOME" "TEMP"
            find -L "${SEARCH_DIRS[@]}" \
                -mindepth 1 -maxdepth 1 -type d 2>/dev/null \
                | sed "s|^$HOME/||" \
                | grep -vxF -e "HOME" -e "TEMP"
        } | awk '!seen[$0]++' | fzf --layout=reverse
    )
fi

[[ -z "${selected:-}" ]] && exit 0

case "$selected" in
    HOME)
        session_name="$HOME_SESSION"
        session_dir="$HOME"
        ;;
    TEMP)
        session_name="$TEMP_SESSION"
        session_dir="$TEMP_DIR"
        ;;
    *)
        if [[ "$selected" == /* ]]; then
            session_dir="$selected"
        else
            session_dir="$HOME/$selected"
        fi
        session_name=$(echo "$session_dir" | awk -F/ '{print $(NF-1)"/"$NF}' | tr './ ' '___')
        ;;
esac

if ! tmux has-session -t "$session_name" 2>/dev/null; then
    mkdir -p "$session_dir"
    tmux new-session -d -s "$session_name" -c "$session_dir"
fi

if [[ -z "${TMUX:-}" ]]; then
    exec tmux attach-session -t "$session_name"
else
    tmux switch-client -t "$session_name"
fi
