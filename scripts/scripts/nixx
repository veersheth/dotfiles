#!/usr/bin/env bash
set -e

CONFIG_DIR="/home/veer/dotfiles/nixos"
CONFIG_FILE="$CONFIG_DIR/configuration.nix"

TMP_BEFORE="$(mktemp)"

# Snapshot before editing
cp "$CONFIG_FILE" "$TMP_BEFORE"

# Edit
nvim "$CONFIG_FILE"

# # If nothing changed compared to before editing
# if diff -q "$TMP_BEFORE" "$CONFIG_FILE" >/dev/null; then
#     echo "No changes detected. Exiting."
#     rm "$TMP_BEFORE"
#     exit 0
# fi

# Show what changed (human-readable, not git-style)
echo "Changes detected:"
echo "-----------------"
diff -u "$TMP_BEFORE" "$CONFIG_FILE" || true
echo

while true; do
    read -rp "Build NixOS? [Y/n/v] (v = verbose): " choice
    case "$choice" in
        y|Y|"")
            VERBOSE=false
            break
            ;;
        v|V)
            VERBOSE=true
            break
            ;;
        n|N)
            echo "Aborting."
            rm "$TMP_BEFORE"
            exit 0
            ;;
        *)
            echo "Invalid input."
            ;;
    esac
done

sudo echo "Rebuilding NixOS..."

if $VERBOSE; then
    sudo nixos-rebuild switch -I nixos-config="$CONFIG_FILE"
else
    sudo nixos-rebuild switch -I nixos-config="$CONFIG_FILE" &> nixos-switch.log \
        || (grep --color=auto error nixos-switch.log && exit 1)
fi


rm "$TMP_BEFORE"

notify-send -e "NixOS Rebuilt OK!" --icon=software-update-available

