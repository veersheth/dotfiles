#!/usr/bin/env bash
set -e

CONFIG_DIR="/home/veer/dotfiles/nixos"
CONFIG_FILE="$CONFIG_DIR/configuration.nix"
UPDATE_CHANNELS=false

usage() {
    cat <<EOF
nixx — NixOS rebuild helper

Flags:
  -u, --update   Update nix channels before rebuilding
  -c, --clean    Garbage collect old nix generations and exit
  -h, --help     Show this help message and exit

Interactive build options (shown after editing config):
  y   Build
  u   Update channels & build
  v   Verbose build
  n   Abort
EOF
}

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    usage
    exit 0
fi

if [[ "$1" == "-c" || "$1" == "--clean" ]]; then
    sudo echo "Collecting nix garbage (removing old generations)..."
    sudo nix-collect-garbage -d
    echo "Done."
    exit 0
fi

if [[ "$1" == "-u" || "$1" == "--update" ]]; then
    UPDATE_CHANNELS=true
fi

TMP_BEFORE="$(mktemp)"
cp "$CONFIG_FILE" "$TMP_BEFORE"

nvim "$CONFIG_FILE"

if ! diff -q "$TMP_BEFORE" "$CONFIG_FILE" >/dev/null; then
    echo "Changes detected:"
    echo "-----------------"
    diff -u "$TMP_BEFORE" "$CONFIG_FILE" || true
    echo
else
    echo "No changes to configuration.nix."
fi

# Multi-choice prompt
while true; do
    echo "Options: [y] Build | [u] Update & Build | [v] Verbose Build | [n] Abort"
    read -rp "Selection? [Y/u/v/n]: " choice
    case "$choice" in
        y|Y|"")
            VERBOSE=false
            break
            ;;
        u|U)
            UPDATE_CHANNELS=true
            VERBOSE=false
            break
            ;;
        v|V)
            VERBOSE=true
            break
            ;;
        n|N)
            echo "Aborting."
            rm "$TMP_BEFORE"
            exit 0
            ;;
        *)
            echo "Invalid input."
            ;;
    esac
done

if [ "$UPDATE_CHANNELS" = true ]; then
    sudo echo "Updating flake inputs..."
    sudo nix flake update --flake /home/veer/dotfiles/nixos
fi

sudo echo "Rebuilding NixOS..."

if $VERBOSE; then
    sudo nixos-rebuild switch --flake /home/veer/dotfiles/nixos#nixos
else
    sudo echo "Building in background...       tail -f ~/nixos-switch.log"
    sudo nixos-rebuild switch --flake /home/veer/dotfiles/nixos#nixos &> ~/nixos-switch.log \
        || (grep --color=auto -A 5 "error:" ~/nixos-switch.log && exit 1)
fi

rm "$TMP_BEFORE"
notify-send -e "NixOS Rebuilt OK!" --icon=software-update-available -t 1000
