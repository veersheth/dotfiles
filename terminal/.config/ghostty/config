window-decoration = none
window-padding-x = 8 
window-padding-y = 6
window-padding-balance = true

background-opacity = 0.80

window-height = 95
window-width = 140

background = #101010
foreground = #F8F7FF
selection-background = #44415a
selection-foreground = #e0def4
cursor-color = #e0def4
cursor-text = #232136

font-size = 13
# font-feature = -calt
# confirm-close-surface = false
font-family = "Iosevka Nerd Font"

keybind = alt+one=text:\x1b1
keybind = alt+two=text:\x1b2
keybind = alt+three=text:\x1b3
keybind = alt+four=text:\x1b4
keybind = alt+five=text:\x1b5
keybind = alt+six=text:\x1b6
keybind = alt+seven=text:\x1b7
keybind = alt+eight=text:\x1b8
keybind = alt+nine=text:\x1b9
keybind = alt+zero=text:\x1b0
keybind = ctrl+enter=text:\x1b\r
