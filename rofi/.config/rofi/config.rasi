configuration {
    modi: "drun,run";
    show-icons: false;
    display-drun: "> ";
    display-dmenu: "> ";
    case-sensitive: false;
}

@theme "/dev/null"

* {
  background-color: transparent;
  text-color: rgba(255, 255, 255, 1);
  font: "JetBrainsMono Nerd Font 16";
}

inputbar {
  // border-radius: 20px;
  padding: 20px;
}

// entry {
//     background-color: @background-color;
//     text-color: @foreground-color;
//     placeholder: "Search...";
// }


window {
  border: 2px;
  background-color: rgba(0, 0, 0, 0.9);
  border-radius: 13px;
  border-color: rgba(100, 100, 100, 0.9);
}

listview {
  padding: 18px;
  // background-color: rgba(0, 0, 0, 0.9);
  // border-radius: 20px;
  // margin: 8px 0 0 0;
  scrollbar: true;
}

element {
  padding: 12px 18px;
}

element-icon { 
  size: 28px;
  margin: 0 20px 0 0 ;
}

element.selected {
  background-color: rgba(90, 90, 90, 0.4);
  // background-color: rgba(114, 151, 179, 0.6);
  border-radius: 14px;
}
