[global]
    monitor = 0
    follow = mouse
    font = JetBrainsMono Nerd Font 14
    padding = 16
    horizontal_padding = 20
    corner_radius = 12
    separator_height = 2
    idle_threshold = 0
    width = 480
    origin = bottom-right
    offset = 20

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 400
    progress_bar_max_width = 400
    progress_bar_corner_radius = 6

    icon_corner_radius = 6
    close_all = ctrl+space
    history = mod1+grave
    shrink = no
    sort = yes
    markup = full
    transparency = 5

[urgency_low]
    background = "#101010"
    foreground = "#8a9dff"
    highlight = "#ff000000"
    timeout = 2

[urgency_normal]
    background = "#101010"
    foreground = "#ffffff"
    highlight = "#a0ebd2"
    timeout = 2

[urgency_critical]
    background = "#101010"
    foreground = "#E34B4B"
    highlight = "#a0ebd2"
    timeout = 15

